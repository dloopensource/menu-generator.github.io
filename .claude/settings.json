{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "npm run test:run --silent >&2 || exit 2",
            "if": "Bash(git commit *)",
            "timeout": 300,
            "statusMessage": "Running tests before commit..."
          }
        ]
      }
    ]
  }
}
