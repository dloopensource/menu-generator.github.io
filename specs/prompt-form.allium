-- allium: 3
-- Prompt form surface specification.
-- The umbrella spec (menu-generator.allium) owns the PromptForm surface
-- and its OnGenerateMenu and OnSetApiKey triggers. This spec adds:
--   - Submission gating rules for Generate button
--   - Suggestion chip surface and interactions
--   - API key change affordance surface and logic

use "./menu-generator.allium" as umbrella

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Flow: Suggestion chip interactions

rule SuggestionChipFillsPrompt {
    -- Clicking a suggestion chip updates the form's prompt textarea.
    -- This is a component-local state update (no downstream system rule fires).
    when: OnSuggestionChipSelected(text: String)
    ensures:
        true

    @guidance
        -- Suggestion chips are pre-filled prompt texts shown below the textarea.
        -- Clicking a chip emits OnSuggestionChipSelected with its full text.
        -- The form updates its textarea binding to this text, allowing the user
        -- to review, edit and then click Generate. Chip texts originate from
        -- component state (see open question for details).
}

-- Flow: API key change affordance

rule ChangeApiKeyAvailable {
    -- Clicking the ChangeApiKeyLink emits OnClearApiKey to the api-key spec.
    when: OnChangeApiKey()
    ensures:
        OnClearApiKey()

    @guidance
        -- A small "Change API key" link appears at the bottom of PromptForm
        -- when an ApiKey is set. Clicking it emits OnChangeApiKey, which this
        -- rule forwards to OnClearApiKey for processing by api-key.allium.
        -- The api-key.ClearRemoves rule consumes OnClearApiKey and removes
        -- both in-memory and localStorage state. The ApiKeyGate surface then
        -- becomes visible again, allowing key re-entry without page reload.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant FormCannotEmitWhileGenerating {
    -- The form cannot emit OnGenerateMenu while a generation is in flight.
    -- This is the contractual commitment: the disabled Generate button is the
    -- UI guard; this invariant is the behavioural guarantee.
    for g in umbrella/Generations:
        g.global_status in {parsing, generating} implies true
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface SuggestionChips {
    -- Suggestion chip affordances within the PromptForm.
    facing user: umbrella/AppUser

    provides:
        OnSuggestionChipSelected(text: String)

    @guidance
        -- Pre-filled prompt suggestions rendered as clickable pills below the
        -- textarea. Each chip carries a piece of example text (e.g., "Italian
        -- restaurant menu", "Fast food items"). Clicking a chip emits
        -- OnSuggestionChipSelected with the chip's full prompt text.
}

surface ChangeApiKeyLink {
    -- API key change affordance at the bottom of the PromptForm.
    facing user: umbrella/AppUser

    provides:
        OnChangeApiKey()

    @guidance
        -- A small link that appears when an ApiKey is set. Clicking clears the
        -- key and resets the UI to the ApiKeyGate state. Implementation: renders
        -- only when an ApiKey exists; hidden when no key is set.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Suggestion chip content and datasource — where do the chip texts come from? Are they hardcoded as component state, loaded from a config file, fetched from an API, or dynamically generated based on context? This spec treats them as opaque UI content."

open question "OnClearApiKey trigger location — this spec's ChangeApiKeyAvailable rule emits OnClearApiKey, which is defined in api-key.allium. Should OnClearApiKey be declared in the umbrella's surfaces for visibility, or remain local to api-key.allium?"
